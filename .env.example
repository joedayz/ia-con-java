# ===========================================
# Configuración del curso IA con Java
# ===========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo a .env en el mismo directorio
#
#    Windows (PowerShell):    Copy-Item .env.example .env
#    Windows (CMD):           copy .env.example .env
#    Mac/Linux:               cp .env.example .env
#
# 2. Edita .env y reemplaza "sk-tu-api-key-aqui" con tu clave real
# 3. NUNCA hagas commit de .env (ya está en .gitignore)
#
# ===========================================

# OBLIGATORIO: OpenAI API Key
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-aqui

# OPCIONAL: Base URL para APIs compatibles con OpenAI
# OPENAI_API_BASE=https://api.openai.com/v1

# ===========================================
# PROVEEDORES ADICIONALES (OPCIONAL)
# ===========================================

# Anthropic (Claude)
# Obtén tu clave en: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui
# ANTHROPIC_API_BASE=https://api.anthropic.com/v1

# Google Gemini
# Obtén tu clave en: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=tu-gemini-api-key-aqui
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
# AZURE_OPENAI_KEY=tu-azure-key-aqui
