set shell := ["zsh", "-cu"]

default:
    @just --list

# Show available recipes.
help:
    @just --list

# Quick compile check.
compile:
    mvn -q -DskipTests compile

# Show which container runtime/compose command will be used.
containers-runtime engine="auto":
    #!/usr/bin/env zsh
    set -euo pipefail
    engine="{{engine}}"
    if [[ "$engine" == "podman" ]]; then
      echo "podman compose"
    elif [[ "$engine" == "docker" ]]; then
      if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        echo "docker compose"
      elif command -v docker-compose >/dev/null 2>&1; then
        echo "docker-compose"
      else
        echo "Docker Compose is not available"
        exit 1
      fi
    elif command -v podman >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
      echo "podman compose"
    elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
      echo "docker compose"
    elif command -v docker-compose >/dev/null 2>&1; then
      echo "docker-compose"
    else
      echo "No supported compose runtime found. Install Podman or Docker Compose, or pass engine=podman|docker."
      exit 1
    fi

# Start compose services with Podman or Docker.
containers-up engine="auto":
    #!/usr/bin/env zsh
    set -euo pipefail
    engine="{{engine}}"
    if [[ "$engine" == "podman" ]]; then
      podman compose -f docker-compose.yml up -d
    elif [[ "$engine" == "docker" ]]; then
      if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
        docker compose -f docker-compose.yml up -d
      elif command -v docker-compose >/dev/null 2>&1; then
        docker-compose -f docker-compose.yml up -d
      else
        echo "Docker Compose is not available"
        exit 1
      fi
    elif command -v podman >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
      podman compose -f docker-compose.yml up -d
    elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
      docker compose -f docker-compose.yml up -d
    elif command -v docker-compose >/dev/null 2>&1; then
      docker-compose -f docker-compose.yml up -d
    else
      echo "No supported compose runtime found. Install Podman or Docker Compose, or pass engine=podman|docker."
      exit 1
    fi

# Stop compose services with Podman or Docker.
