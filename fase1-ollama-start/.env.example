# Configuración opcional para Ollama
# Si no se especifica, usará valores por defecto

# URL base de Ollama (por defecto: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo por defecto (si hay varios instalados)
OLLAMA_MODEL=mistral

# Nota: NO SE NECESITA API KEY para Ollama 🎉
