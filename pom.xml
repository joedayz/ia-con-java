<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.joedayz</groupId>
    <artifactId>ia-con-java</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>IA con Java (parent)</name>
    <description>Curso IA con Java - Un proyecto Maven por fase</description>

    <modules>
        <module>common</module>
        <module>fase1</module>
        <module>fase1-quarkus</module>
        <module>fase1-quarkus-ollama</module>
        <module>fase1-ollama</module>
        <module>fase2</module>
        <module>fase2-ollama</module>
        <module>fase3</module>
        <module>fase3-ollama</module>
        <module>fase3-spring-ai</module>
        <module>fase3-spring-ai-ollama</module>
        <module>fase4-spring-ai-ollama-pgvector</module>
        <module>fase4-spring-ai-openai-pgvector</module>
        <module>fase4-spring-ai-tool-calling</module>
        <module>fase4-langchain4j-tool-calling</module>
        <module>fase5-mcp</module>
        <module>fase7/dynamic-renderer</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <source>25</source>
                        <target>25</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
